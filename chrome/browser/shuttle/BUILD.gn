# The in-browser MCP server (agent profiles, sessions, tabs). Design:
# tools/shuttle/docs/MCP.md.

assert(!is_android)

source_set("shuttle") {
  public = [
    "home_tab.h",
    "shuttle_service.h",
    "shuttle_service_factory.h",
  ]

  public_deps = [
    ":network_access",
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
    "//content/public/browser",
    "//ui/gfx",
  ]
}

# Shuttle command-line switches that live outside chrome_switches.h.
source_set("switches") {
  sources = [ "switches.h" ]
}

# Network mode (--shuttle-listen) and its access token.
source_set("network_access") {
  sources = [
    "network_access.cc",
    "network_access.h",
  ]
  deps = [
    "//base",
    "//crypto",
    "//net",
  ]
}

# Agent partition helpers the network stack calls (session-cookie
# persistence); no dependency on the service.
source_set("agent_partition") {
  sources = [
    "agent_partition.cc",
    "agent_partition.h",
    "pref_names.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/prefs",
    "//content/public/browser",
  ]
}

# Per-agent proxy: ProxySpec, its storage (encrypted password), the service that
# applies it to the agent's NetworkContext, and the proxy login. Called by the
# network stack and the content browser client: no dependency on
# ShuttleService / ProfileRegistry (:impl). Design:
# tools/shuttle/docs/FEATURES.md, "Per-agent proxy".
source_set("agent_proxy") {
  sources = [
    "agent_proxy.cc",
    "agent_proxy.h",
    "profile_proxy_service.cc",
    "profile_proxy_service.h",
    "profile_proxy_service_factory.cc",
    "profile_proxy_service_factory.h",
    "proxy_auth.cc",
    "proxy_auth.h",
  ]
  public_deps = [
    "//base",
    "//net",
  ]
  deps = [
    ":agent_partition",
    "//chrome/browser/profiles:profile",
    "//chrome/common:constants",
    "//components/keyed_service/content",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/common",
    "//components/prefs",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/blink/public/common",
    "//url",
  ]
}

source_set("impl") {
  sources = [
    "agent_browser_sidecar.cc",
    "agent_browser_sidecar.h",
    "avatar_cache.cc",
    "avatar_cache.h",
    "home_tab.cc",
    "home_tab_manager.cc",
    "home_tab_manager.h",
    "mcp_tools.cc",
    "mcp_tools.h",
    "page_tools.cc",
    "page_tools.h",
    "page_tools_data.inc",
    "profile_registry.cc",
    "profile_registry.h",
    "proxy_check.cc",
    "proxy_check.h",
    "proxy_tab_sync.cc",
    "proxy_tab_sync.h",
    "session_cdp_filter.cc",
    "session_cdp_filter.h",
    "session_manager.cc",
    "session_manager.h",
    "shuttle_service.cc",
    "shuttle_service_factory.cc",
  ]

  deps = [
    ":agent_partition",
    ":agent_proxy",
    ":shuttle",
    ":switches",
    "//base",
    "//base:i18n",
    "//chrome/browser:browser_features",
    "//chrome/browser:shell_integration",
    "//chrome/browser/headless",
    "//chrome/browser/lifetime",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles/keep_alive",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/tabs:tab_enums",
    "//chrome/browser/ui/tabs:tab_group",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/tabs:tab_strip_model_observer",
    "//components/keep_alive_registry",
    "//components/keyed_service/content",
    "//components/pref_registry",
    "//components/prefs",
    "//components/tab_groups",
    "//components/tabs:public",
    "//components/version_info",
    "//components/viz/common",
    "//content/public/browser",
    "//crypto",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/data_decoder/public/cpp",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//skia",
    "//third_party/re2",
    "//ui/base",
    "//ui/base/clipboard",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//ui/gfx/geometry",
    "//url",
  ]
}
