# ManagedProfileProvider) nor on ShuttleService.
source_set("managed_profile_bootstrap") {
  sources = [
    "managed_profile_bootstrap.cc",
    "managed_profile_bootstrap.h",
  ]
  public_deps = [
    ":managed_network_admission",
    ":browser_profile_registry",
    "//base",
  ]
  deps = [
    ":agent_persona",
    ":agent_proxy",
    ":fingerprint_persona",
    ":pref_names",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/common",
    "//components/prefs",
    "//crypto",
  ]
}

