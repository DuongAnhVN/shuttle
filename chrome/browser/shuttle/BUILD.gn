# Per-agent proxy: ProxySpec, its storage (encrypted password) and the service
# that applies it to the agent's NetworkContext. Called by the network stack:
# no dependency on ShuttleService / ProfileRegistry (:impl), on the tab and
# login code (:agent_proxy_auth) nor on the fingerprint persona. Design:
# tools/shuttle/docs/FEATURES.md, "Per-agent proxy".
source_set("agent_proxy") {
  sources = [
    "agent_proxy.cc",
    "agent_proxy.h",
    "profile_proxy_service.cc",
    "profile_proxy_service.h",
    "profile_proxy_service_factory.cc",
    "profile_proxy_service_factory.h",
  ]
  public_deps = [
    "//base",
    "//net",
  ]
  deps = [
    ":managed_network_admission",
    ":agent_partition",
    ":pref_names",
    "//chrome/browser/profiles:profile",
    "//chrome/common:constants",
    "//components/keyed_service/content",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/common",
    "//components/prefs",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/blink/public/common",
    "//url",
  ]
}

# Fingerprint persona: the versioned schema of the device a Chromium profile
# presents (os, browser, user agent, client hints, locale, timezone, hardware,
# screen), its pref and MCP forms, and its coherence checks. Pure data, no
# dependency on the service. Schema and persistence only. Design:
# tools/shuttle/docs/FINGERPRINT.md.
source_set("fingerprint_persona") {
  sources = [
    "fingerprint_persona.cc",
    "fingerprint_persona.h",
  ]
  public_deps = [ "//base" ]
}

# The profile's fingerprint persona service (one persona per Chromium profile,
# shared by all tabs, agents and partitions): where the runtime reads it from
# (ProfilePersonaService, the profile pref), its mapping to renderer
# preferences (persona_runtime) and to the profile's NetworkContexts
# (Accept-Language, user agent). This is all the network stack needs: no
# WebContents, navigation or tab code (:persona_tab_prefs), no dependency on
# ShuttleService / ProfileRegistry (:impl, which writes through the service),
# on :agent_proxy or on :agent_partition.
source_set("agent_persona") {
  sources = [
    "persona_runtime.cc",
    "persona_runtime.h",
    "profile_persona_service.cc",
    "profile_persona_service.h",
    "profile_persona_service_factory.cc",
    "profile_persona_service_factory.h",
  ]
  public_deps = [
    ":fingerprint_persona",
    "//base",
    "//components/keyed_service/core",
    "//third_party/blink/public/common",
  ]
  deps = [
    ":managed_network_admission",
    ":agent_proxy",  # FailClosedNetConfig: managed profile without a persona.
    ":pref_names",
    "//chrome/browser/profiles:profile",
    "//components/embedder_support:user_agent",
    "//components/keyed_service/content",
    "//components/pref_registry",
    "//components/prefs",
    "//net",
    "//services/network/public/mojom",
    "//third_party/icu",
  ]
}

# Applies the profile persona to WebContents (renderer preferences, user agent
# override, per-navigation override flag) and to worker preferences. Called by
# the tab prefs and the content browser client; depends on the content browser
# API, which is why it is not part of :agent_persona.
source_set("persona_tab_prefs") {
  sources = [
    "persona_tab_prefs.cc",
    "persona_tab_prefs.h",
  ]
  deps = [
    ":agent_persona",
    ":fingerprint_persona",
    "//base",
    "//chrome/browser/profiles:profile",
    "//content/public/browser",
    "//third_party/blink/public/common",
    "//url",
  ]
}

# Native WebRTC IP handling: disable_non_proxied_udp for a proxied agent or a
# profile with an explicit proxy of its own (Chromium's WebRtcIpHandlingPolicy
# only, no spoofing). Pure pref logic, no content dependency.
source_set("webrtc_policy") {
  sources = [
    "webrtc_policy.cc",
    "webrtc_policy.h",
  ]
  deps = [
    "//base",
    "//components/prefs",
    "//components/proxy_config",
    "//third_party/blink/public/common",
    "//third_party/blink/public/mojom:mojom_platform_headers",
  ]
}

# Proxy login and the per-tab renderer preferences of agent tabs
# (ApplyAgentRendererPrefs: WebRTC policy of proxied agents, then the profile
# persona). Called by the content browser client, the tab prefs and :impl.
source_set("agent_proxy_auth") {
  sources = [
    "proxy_auth.cc",
    "proxy_auth.h",
  ]
  public_deps = [
    "//content/public/browser",
    "//net",
  ]
  deps = [
    ":agent_partition",
    ":agent_proxy",
    ":persona_tab_prefs",
    ":webrtc_policy",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/common:constants",
    "//components/prefs",
    "//third_party/blink/public/common",
  ]
}

# --- Isolated Chromium Profiles (lane B1) --------------------------------------
# Contract: tools/shuttle/docs/PROFILES.md. Opt-in (--shuttle-isolated-profiles).
# NOT YET COMPILED: written on a machine without a Chromium build; see
# "Implementation status" in that document.

# Persistent registry of managed Profiles (ShuttleBrowserProfiles.json), the
# state machine and request-id idempotency. Plain data: no Profile, no content.
source_set("browser_profile_registry") {
  sources = [
    "browser_profile_registry.cc",
    "browser_profile_registry.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//crypto" ]
}

# Browser-wide session/target ownership indexes (locators, never authority).
source_set("browser_owner_index") {
  sources = [
    "browser_owner_index.cc",
    "browser_owner_index.h",
  ]
  public_deps = [ "//base" ]
}

# The browser administration credential (ShuttleManagerAdminToken).
source_set("browser_admin_auth") {
  sources = [
    "browser_admin_auth.cc",
    "browser_admin_auth.h",
