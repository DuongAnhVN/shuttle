# --- Native tests of the isolated Chromium Profiles (NOT YET COMPILED) --------
# This tree has no desktop unit_tests / browser_tests aggregate, so the unit
# tests get a small standalone runner. The browser test is a source_set that
# can join a browser_tests executable once the pruned Chrome test harness is
# restored. //chrome/test:shuttle_profile_tests currently builds ONLY unit tests;
# it does NOT compile or execute browser_profile_lifecycle_browsertest.cc.

source_set("unit_tests") {
  testonly = true
  sources = [
    "browser_profile_registry_unittest.cc",
    "scope_auth_unittest.cc",
  ]
  deps = [
    ":browser_admin_auth",
    ":browser_owner_index",
    ":browser_profile_registry",
    ":scope_auth",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}

test("shuttle_profile_unittests") {
  deps = [
    ":unit_tests",
    "//base/test:run_all_unittests",
  ]
}

declare_args() {
  # The browser test needs //chrome/test:test_support, which this pruned tree
  # cannot load (empty test_proto and missing Chrome test support/runner sources).
  # This flag exposes source-only tests, NOT a runnable browser-test executable.
  shuttle_build_browser_tests = false
}

if (shuttle_build_browser_tests) {
source_set("browser_tests") {
  testonly = true
  sources = [ "browser_profile_lifecycle_browsertest.cc" ]
  deps = [
    ":agent_proxy",
    ":managed_network_admission",
    ":agent_persona",
    ":browser_profile_router",
    ":fingerprint_persona",
    ":managed_profile_bootstrap",
    ":pref_names",
    ":switches",
    "//base",
    "//base/test:test_support",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/common:constants",
    "//chrome/test:test_support",
    "//components/keyed_service/content",
    "//components/prefs",
    "//content/test:test_support",
    "//content/public/browser",
    "//net:test_support",
    "//net/traffic_annotation:test_support",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
